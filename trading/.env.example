# Zerodha Kite Connect credentials
# Get API_KEY and API_SECRET from: kite.trade/developers → your app → settings
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Your Zerodha login
KITE_USER_ID=your_zerodha_client_id   # e.g. AB1234
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_totp_secret_key  # see README for how to get this

# Risk config (override defaults from config.py if needed)
# CAPITAL=75000
# WEEKLY_DRAWDOWN=7500
# MONTHLY_DRAWDOWN=15000
# TOTAL_DRAWDOWN=22500

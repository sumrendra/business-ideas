# Sanity Project Config (public — safe to expose in browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token (server-side only — never expose in browser)
# Create a token with Viewer role at sanity.io/manage
SANITY_API_TOKEN=your_api_token_here

# Webhook secret — used to validate revalidation requests from Sanity
# Set this to any random string (e.g. openssl rand -hex 32)
SANITY_WEBHOOK_SECRET=your_webhook_secret_here
